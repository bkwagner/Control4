# Control4 cloud account (https://customer.control4.com)
CONTROL4_ACCOUNT_EMAIL=you@example.com
CONTROL4_ACCOUNT_PASSWORD=changeme

# Local Control4 director (your HC-250/HC-800/EA-x controller)
CONTROL4_DIRECTOR_IP=192.168.1.50

# Optional: pin to a specific controller by common name if you have multiple
# CONTROL4_CONTROLLER_COMMON_NAME=MyController_000000000000

# MCP server (SSE transport). Required whenever the server listens on anything
# other than 127.0.0.1 (including Docker). Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send it as:  Authorization: Bearer <token>
CONTROL4_MCP_TOKEN=

# Allow send_command to issue UNLOCK / DISARM / ARM_* (off by default).
# CONTROL4_ALLOW_SECURITY=1

# Optional: DirectorLink (github.com/IsraelCIL/DirectorLink, formerly C4Bridge)
# installed on the Director. When set, lights / thermostats / fans / blinds /
# alarm status are read and controlled through it - no Control4 cloud login
# needed for those. Get an API key by pairing: Composer -> DirectorLink ->
# "New Pairing Code", then
#   POST http://<director>:41999/v1/auth/pair  {"pairing_code": "...", "name": "control4-mcp"}
# (The old CONTROL4_C4BRIDGE_TOKEN / _URL names are still accepted.)
# CONTROL4_DIRECTORLINK_TOKEN=
# CONTROL4_DIRECTORLINK_URL=http://192.168.1.50:41999   # defaults to the director IP
