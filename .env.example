# Control4 cloud account (https://customer.control4.com)
CONTROL4_ACCOUNT_EMAIL=you@example.com
CONTROL4_ACCOUNT_PASSWORD=changeme

# Local Control4 director (your HC-250/HC-800/EA-x controller)
CONTROL4_DIRECTOR_IP=192.168.1.50

# Optional: pin to a specific controller by common name if you have multiple
# CONTROL4_CONTROLLER_COMMON_NAME=MyController_000000000000
